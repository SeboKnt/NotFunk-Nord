{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notfunk-toolkit",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_CACHE",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ]
}
